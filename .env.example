# ==============================================================================
# VATSALYA VATIKA ASHRAM — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# COPY THIS TO Vercel Project Settings > Environment Variables
# DO NOT COMMIT REAL SECRETS TO GIT!
# ==============================================================================

# 1. Environment & Client URL
NODE_ENV=production
CLIENT_URL=https://your-vercel-domain.vercel.app

# 2. Database (Free tier on MongoDB Atlas: https://www.mongodb.com/cloud/atlas)
# Leave empty or omit if testing initially with the built-in fallback store
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/vatsalya_vatika?retryWrites=true&w=majority

# 3. Security (Generate a long random string for production JWT token signing)
JWT_SECRET=vatsalya_ashram_super_secure_production_secret_key_2026

# 4. Admin Email Notifications (Optional: for instant alerts on new donations & contacts)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_ashram_gmail@gmail.com
EMAIL_PASS=your_gmail_16_char_app_password
EMAIL_TO=admin@vatsalyavatika.org

# 5. SMS Alerts (Optional)
FAST2SMS_API_KEY=
ADMIN_PHONE=
