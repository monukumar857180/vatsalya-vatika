{
  "buildCommand": "npm install && cd frontend && npm install --include=dev && npm run build",
  "outputDirectory": "frontend/dist",

  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
